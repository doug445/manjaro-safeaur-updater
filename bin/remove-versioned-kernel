#!/bin/bash
# remove-versioned-kernel — fully evict a Manjaro versioned kernel.
#
# Removes <kernel>, <kernel>-headers and every installed <kernel>-* package
# that depends on <kernel> — the extramodules (-nvidia, -r8168, -zfs,
# -virtualbox-host-modules, ...) — in one transaction. A same-prefix package
# that does NOT depend on it, such as the separate linux66-rt kernel, is left
# alone. The mkinitcpio remove hook (60-mkinitcpio-remove.hook) reads the
# kernel's preset before deletion and removes the UKI from the ESP.
# systemd-boot autodiscovers UKIs via BLS Type #2, so the boot entry
# disappears with the UKI file. DKMS hooks clean built modules.
#
# This script ALSO prunes the removed packages' names from IgnorePkg in
# /etc/pacman.conf (Manjaro's hook only maintains that line on Install).
# Only those tokens go; every other entry survives, and nothing is ever added.
#
# Refuses to remove the currently-booted kernel or to leave the system
# with zero versioned kernels.
#
# Usage: sudo remove-versioned-kernel [--noconfirm] <linuxNN>   # e.g. linux66
#
# --noconfirm skips the final y/N prompt. It does NOT skip the three safety
# checks below — those are the actual guards and have no bypass.

set -euo pipefail

ASSUME_YES=0
ARGS=()
for a in "$@"; do
    case "$a" in
        --noconfirm) ASSUME_YES=1 ;;
        -h|--help)   sed -n '2,/^$/p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *)           ARGS+=("$a") ;;
    esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 [--noconfirm] <linuxNN>" >&2
    echo "  e.g.: $0 linux66" >&2
    exit 2
fi

KERNEL="$1"

if [[ ! "$KERNEL" =~ ^linux[0-9]+$ ]]; then
    echo "ERROR: '$KERNEL' is not a Manjaro versioned kernel name (expected linuxNN)" >&2
    exit 2
fi

if [[ $EUID -ne 0 ]]; then
    echo "ERROR: must run as root (sudo)" >&2
    exit 2
fi

# --- Safety check 1: is this kernel even installed? ---
if ! pacman -Qq "$KERNEL" >/dev/null 2>&1; then
    echo "[remove] '$KERNEL' is not installed — nothing to do" >&2
    exit 0
fi

# --- Safety check 2: are we currently booted into it? Two independent tests. ---
# (a) which package owns the running kernel's module directory;
# (b) whether the installed version is the running version — `uname -r` on a
#     Manjaro kernel is "<pkgver>-<pkgrel>-MANJARO". The module directory can
#     be unowned (force-removed package, manual install) while that kernel is
#     still the one running, and (a) alone would then wave the removal through.
RUNNING="$(uname -r)"
RUNNING_PKG="$(pacman -Qoq "/usr/lib/modules/${RUNNING}" 2>/dev/null | head -1 || true)"
KVER="$(pacman -Q "$KERNEL" 2>/dev/null | awk '{print $2}')"
KVER="${KVER#*:}"     # an epoch, if any, never appears in uname -r
if [[ "$RUNNING_PKG" == "$KERNEL" || "$RUNNING" == "$KVER" || "$RUNNING" == "$KVER-"* ]]; then
    echo "ERROR: refusing to remove $KERNEL — you are currently booted into it ($RUNNING)" >&2
    echo "       reboot into another kernel first, then re-run this script" >&2
    exit 3
fi

# --- Safety check 3: would this leave 0 versioned kernels? ---
mapfile -t INSTALLED_KERNELS < <(pacman -Qq | grep -E '^linux[0-9]+$')
REMAINING=()
for k in "${INSTALLED_KERNELS[@]}"; do
    [[ "$k" != "$KERNEL" ]] && REMAINING+=("$k")
done
if (( ${#REMAINING[@]} == 0 )); then
    echo "ERROR: refusing to remove $KERNEL — it would leave 0 versioned kernels installed" >&2
    exit 3
fi

# --- Build the package list ---
# The kernel, its headers (by name: they do not depend on the kernel), and
# every installed <kernel>-* package that DOES depend on it. The dependency is
# the criterion, not the name prefix: it is what pacman will refuse the
# transaction over if left out, and it is what tells a linux66 extramodule
# apart from the unrelated linux66-rt kernel.
TO_REMOVE=("$KERNEL")
if pacman -Qq "$KERNEL-headers" >/dev/null 2>&1; then
    TO_REMOVE+=("$KERNEL-headers")
else
    echo "[remove] note: $KERNEL-headers not installed, skipping"
fi
EXTRAMODULES=()
STRANGERS=()
while read -r p; do
    [[ -z "$p" || "$p" == "$KERNEL-headers" ]] && continue
    deps=$(LC_ALL=C pacman -Qi "$p" 2>/dev/null \
           | awk '/^Depends On/ { sub(/^[^:]*:[[:space:]]*/, ""); print; exit }')
    depends_on_kernel=0
    for d in $deps; do
        [[ "${d%%[<>=]*}" == "$KERNEL" ]] && { depends_on_kernel=1; break; }
    done
    if (( depends_on_kernel )); then EXTRAMODULES+=("$p"); else STRANGERS+=("$p"); fi
done < <(pacman -Qq 2>/dev/null | grep -E "^${KERNEL}-" || true)
TO_REMOVE+=("${EXTRAMODULES[@]}")

echo "[remove] currently booted: $RUNNING (${RUNNING_PKG:-no owning package})"
echo "[remove] removing: ${TO_REMOVE[*]}"
for s in "${STRANGERS[@]}"; do
    echo "[remove] note: $s shares the name prefix but does not depend on $KERNEL — left alone"
done
echo "[remove] kernels remaining after this: ${REMAINING[*]}"
echo

# --- Confirm ---
if (( ASSUME_YES )); then
    echo "[remove] --noconfirm: proceeding with pacman -Rns ${TO_REMOVE[*]}"
else
    read -r -p "[remove] proceed with pacman -Rns ${TO_REMOVE[*]}? [y/N] " ans </dev/tty
    case "$ans" in
        y|Y|yes|Yes) : ;;
        *) echo "[remove] aborted by user"; exit 1 ;;
    esac
fi

# --- Do the removal ---
# -R: remove   -n: don't save .pacsave  -s: also remove unused deps
# --noconfirm has to reach pacman too, or the flag only silences OUR prompt
# and the run then blocks forever on pacman's own.
PACMAN_ARGS=(-Rns)
(( ASSUME_YES )) && PACMAN_ARGS+=(--noconfirm)
pacman "${PACMAN_ARGS[@]}" "${TO_REMOVE[@]}"

# --- Prune IgnorePkg ---
# Only the names just removed are taken out, from every IgnorePkg line. An
# earlier version rebuilt the line from a hardcoded list (survivors plus
# nvidia userspace), which silently dropped whatever else the user had pinned
# and added holds nobody asked for. Nothing is added here; a line left with no
# entries stays as `IgnorePkg =`, which pacman accepts.
# Overridable so the loopback suite can exercise the rewrite against a
# throwaway pacman root instead of the real /etc.
PACMAN_CONF="${SAFEUP_PACMAN_CONF:-/etc/pacman.conf}"
# Where this system keeps its UKIs. Overridable for the same reason: the
# suite has to exercise BOTH the present and the absent case on any host.
UKI_DIR="${SAFEUP_UKI_DIR:-/boot/efi/Linux}"

PRUNED=$(mktemp)
trap 'rm -f "$PRUNED"' EXIT
awk -v remove="${TO_REMOVE[*]}" '
    BEGIN { n = split(remove, r, " "); for (i = 1; i <= n; i++) del[r[i]] = 1 }
    /^[[:space:]]*IgnorePkg[[:space:]]*=/ {
        eq = index($0, "="); lhs = substr($0, 1, eq); rhs = substr($0, eq + 1)
        m = split(rhs, t, /[[:space:]]+/); out = ""
        for (i = 1; i <= m; i++) if (t[i] != "" && !(t[i] in del)) out = out " " t[i]
        print lhs out; next
    }
    { print }' "$PACMAN_CONF" > "$PRUNED"
if cmp -s "$PRUNED" "$PACMAN_CONF"; then
    echo "[remove] IgnorePkg in $PACMAN_CONF names none of the removed packages — left as-is"
else
    BACKUP="$PACMAN_CONF.bak-$(date +%Y%m%d-%H%M%S)"
    cp -p "$PACMAN_CONF" "$BACKUP"
    cat "$PRUNED" > "$PACMAN_CONF"      # in place, so mode and owner are kept
    echo
    echo "[remove] IgnorePkg pruned of: ${TO_REMOVE[*]}. Backup: $BACKUP"
    grep -nE '^[[:space:]]*IgnorePkg' "$PACMAN_CONF" || true
fi

# --- Verify state ---
echo
echo "=== verification ==="
echo
echo "1) Packages gone:"
for p in "${TO_REMOVE[@]}"; do
    pacman -Qq "$p" >/dev/null 2>&1 && echo "  WARNING: $p still installed" || echo "  ok: $p not installed"
done
echo
echo "2) UKI gone (should not exist):"
found_uki=0
for f in "$UKI_DIR"/manjaro-*.efi; do
    [[ -e "$f" ]] || continue          # unmatched glob stays literal
    [[ "$f" == *RESCUE* ]] && continue # the rescue image is meant to persist
    echo "  $f"; found_uki=1
done
(( found_uki )) || echo "  ok: no manjaro-*.efi UKIs present"
echo
echo "3) Modules dir gone:"
ls -d /usr/lib/modules/*MANJARO 2>/dev/null || echo "  no module dirs found"
echo
echo "4) DKMS state:"
dkms status 2>/dev/null | grep -E "^\S+/\S+, .*$" || echo "  (dkms not configured or no modules)"
echo
echo "5) Boot entries (systemd-boot autodiscovers UKIs from $UKI_DIR):"
# Guarded, like every other probe in this section. `2>/dev/null` hides the
# message but NOT the exit status: ls returns 2 for a missing directory, and
# under `set -e` that killed the script here -- after the removal and the
# IgnorePkg rewrite had both already succeeded. The tool did the whole job
# and then reported failure, on every system whose ESP is not mounted at
# /boot/efi with a Linux/ in it.
ls "$UKI_DIR"/ 2>/dev/null || echo "  (no $UKI_DIR — not a UKI/systemd-boot layout)"
echo
echo "[remove] done. Reboot is not required — running kernel ($RUNNING) is unaffected."
